# Cloudflare account to deploy to (optional). Only needed when `wrangler whoami`
# lists more than one account; wrangler reads it from this file.
CLOUDFLARE_ACCOUNT_ID=

# MongoDB
# Connection string (required). The database name comes from the URI path.
# Local default targets `docker compose up -d` from the repo root; for Atlas use
# your mongodb+srv:// string (as a Worker secret in deployed environments).
MONGODB_URI=mongodb://127.0.0.1:27017/boilerplate
